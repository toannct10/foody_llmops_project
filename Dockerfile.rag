FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements-demo.txt requirements-phobert-absa.txt ./
RUN pip install torch==2.9.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements-demo.txt -r requirements-phobert-absa.txt
COPY app ./app
COPY src ./src
COPY prompts ./prompts
COPY config ./config
COPY sql ./sql
COPY qwen_v1.yaml ./qwen_v1.yaml
COPY qwen_v3_3b.yaml ./qwen_v3_3b.yaml
EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "app/app.py", "--server.address", "0.0.0.0"]
