# Use the existing OAuth CLI profile; no PAT is required.
# Leave profile blank to use SDK default unified authentication instead.
DATABRICKS_CONFIG_PROFILE=shopee
# Optional legacy PAT configuration only:
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
DATABRICKS_CATALOG=shopee
DATABRICKS_RAW_SCHEMA=raw
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold
DATABRICKS_VOLUME=landing
DATABRICKS_JOB_ID=
DATABRICKS_JOB_TIMEOUT_MINUTES=60

# Optional Foody cloud RAW foundation. Set in the shell for the host CLI, or
# use a private .env.cloud for the optional cloud Airflow Compose overlay.
# AWS credentials use the SDK default chain (profile, environment or IAM role).
# AWS_REGION=ap-southeast-1
# AWS_PROFILE=
# FOODY_S3_BUCKET=
# FOODY_S3_PREFIX=foody
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_FILE=
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
# SNOWFLAKE_ROLE=FOODY_INGEST_ROLE
# SNOWFLAKE_DBT_ROLE=FOODY_TRANSFORM_ROLE
# SNOWFLAKE_BOOTSTRAP_ROLE=
# SNOWFLAKE_WAREHOUSE=FOODY_WH
# SNOWFLAKE_DATABASE=FOODY
# SNOWFLAKE_RAW_SCHEMA=RAW
# SNOWFLAKE_STAGING_SCHEMA=STAGING
# SNOWFLAKE_MART_SCHEMA=MART
# SNOWFLAKE_STORAGE_INTEGRATION=FOODY_S3_INTEGRATION
# FOODY_CLOUD_DBT_ENABLED=false
# Optional AI-only PostgreSQL DSN. Create/grant the role with
# sql/postgres/readonly.sql, then inject its password privately.
# FOODY_AI_DATABASE_URL=postgresql://foody_ai_readonly:<private-password>@localhost:5433/foody
# Optional monitoring cost assumptions. Disabled means no monetary estimate.
# COST_TRACKING_ENABLED=false
# LOCAL_INFERENCE_DEVICE=cpu
# LOCAL_CPU_COST_PER_HOUR=
# LOCAL_GPU_COST_PER_HOUR=
# SNOWFLAKE_CREDIT_PRICE=
# AWS_ESTIMATE_MODE=disabled
# FOODY_AIRFLOW_MONITOR_ENABLED=false
DATA_DIR=data
STATE_DIR=state
LOG_DIR=logs
CRAWL_CONCURRENCY=1
CRAWL_DELAY_SECONDS=5
CRAWL_TIMEOUT_MS=30000
CRAWL_HEADLESS=true
REVIEWS_ENABLED=false
CRAWL_CRON=0 2 * * *
CRAWL_TIMEZONE=Asia/Ho_Chi_Minh
CRAWL_KEYWORD=tai nghe bluetooth
CRAWL_PAGES=2
# Leave unset for manual runs (Prefect starts a temporary local server).
# PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false

# Phase 2: no dataset or trained model is shipped. Credentials remain outside DVC.
# Default local tracking uses sqlite:///state/mlflow.db.
# For the existing OAuth CLI profile, use MLFLOW_TRACKING_URI=databricks://shopee
MLFLOW_EXPERIMENT_NAME=/Shared/shopee-sentiment
MLFLOW_REGISTRY_URI=databricks-uc
# MLFLOW_TRACKING_URI=databricks://shopee
# Set an explicit, registered immutable version after training and registration:
# MLFLOW_MODEL_URI=models:/shopee.ml.sentiment_classifier/1
# Local serving is opt-in and requires no MLFLOW_TRACKING_URI:
# LOCAL_MODEL_PATH=models/baseline.joblib
INFERENCE_LOG_PATH=logs/inference.jsonl
